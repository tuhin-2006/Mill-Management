# Supabase API URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anonymous Key (Project Settings > API > Project API keys > anon / public)
# Note: Current Supabase Next.js documentation recommends NEXT_PUBLIC_SUPABASE_ANON_KEY for client and SSR initialization
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Project Settings > API > Project API keys > service_role)
# WARNING: Server-only! NEVER prefix this with NEXT_PUBLIC_ or expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
